{
  "name": "biew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "import": "tsx scripts/import.ts",
    "fixture": "tsx scripts/make-fixture.ts",
    "staff": "tsx scripts/create-staff.ts",
    "verify:channels": "tsx scripts/verify-channels.ts",
    "e2e": "node scripts/e2e/run-all.mjs",
    "e2e:internet": "node scripts/e2e/internet.e2e.mjs",
    "e2e:local": "node scripts/e2e/local.e2e.mjs",
    "e2e:home": "node scripts/e2e/home.e2e.mjs",
    "e2e:bg": "node scripts/e2e/bg.e2e.mjs",
    "e2e:ime": "node scripts/e2e/ime.e2e.mjs",
    "e2e:offline": "npm run build && node scripts/e2e/offline.e2e.mjs",
    "e2e:upgrade": "npm run build && node scripts/e2e/upgrade.e2e.mjs",
    "e2e:latency": "node scripts/e2e/latency.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "idb": "^8.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "iconv-lite": "^0.7.3",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
